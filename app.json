{
  "expo": {
    "name": "Weather To Go",
    "slug": "weather-to-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "weathercompared",
    "icon": "./assets/weather-to-go-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#10203F"
    },
    "ios": {
      "buildNumber": "9",
      "supportsTablet": false,
      "bundleIdentifier": "com.dhaiwat.weathercompared",
      "appleTeamId": "SBX85HC7ML",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.dhaiwat.weathercompared"
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Weather To Go uses your location to show the weather where you are.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/weather-to-go-icon.png",
        "backgroundColor": "#10203F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Weather To Go to show the weather where you are."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.dhaiwat.weathercompared.widget",
                  "targetName": "WeatherComparedWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.dhaiwat.weathercompared"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "b3a0a17a-b921-4346-aaff-8347e400690f"
      }
    }
  }
}
